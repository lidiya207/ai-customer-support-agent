APP_NAME="AI Customer Support Agent"
APP_ENV="development"
# Use root:password@... if your MySQL root has a password; omit :password if it is empty
DATABASE_URL="mysql+pymysql://root@127.0.0.1:3306/ai_support"

# LLM: auto | ollama | openai
# auto = use OpenAI when OPENAI_API_KEY is set, otherwise Ollama
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_PREDICT=128
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m

# Agent can look up public info online (DuckDuckGo + Wikipedia)
ENABLE_WEB_SEARCH=true
WEB_SEARCH_TIMEOUT_SECONDS=8

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
JWT_SECRET_KEY="change-this-in-production-use-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mini Telegram bot — get a token from @BotFather, then:
#   uv run python scripts/run_telegram_bot.py
TELEGRAM_BOT_TOKEN=""
TELEGRAM_HISTORY_LIMIT=12
